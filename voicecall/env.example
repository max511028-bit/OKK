# Шаблон voicecall.env — реальный файл создаётся в C:\ProgramData\sth\voicecall.env
# и в git НЕ коммитится.
#
# Возьми значения из личного кабинета Novofon:
# Настройки → Сотрудники и отделы → клик на пользователя → вкладка
# «ВАТС и данные для стороннего оборудования»

SIP_SERVER=sip.novofon.ru
SIP_PORT=5060
SIP_USER=0125878
SIP_PASS=ЗАМЕНИ_НА_РЕАЛЬНЫЙ_ПАРОЛЬ

# API-ключи Novofon. Включи галку "Использовать ключ API" во вкладке API
# и сохрани ключ. Нужны для: заявки на звонок (Call API), забора записей
# разговоров, стоимости кампании и проверки статуса SIP-линии.
NOVOFON_API_KEY=
NOVOFON_API_SECRET=

# Кого и с какого номера набирать (личный кабинет Novofon).
# EMPLOYEE_ID — id сотрудника, чья линия сводит разговор;
# VIRTUAL_NUMBER — номер, который увидит кандидат.
NOVOFON_EMPLOYEE_ID=
NOVOFON_VIRTUAL_NUMBER=

# Портал: откуда агент забирает контакты и куда шлёт результаты.
# PORTAL_URL — БАЗА API со слэшем на конце не нужна, пример:
#   https://portalsth.ru/tasks/api
# PORTAL_PASSWORD — пароль портала (тот же, что вводит рекрутёр).
PORTAL_URL=https://portalsth.ru/tasks/api
PORTAL_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ_ПОРТАЛА
